{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platformAutomerge": false,
  "ignoreDeps": [
    "ruma"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CPM dependencies (GitHub) in CMakeLists.txt",
      "managerFilePatterns": [
        "/^CMakeLists\\.txt$/"
      ],
      "matchStrings": [
        "GIT_REPOSITORY\\s+https://github\\.com/(?<depName>[^/]+/[^/]+)\\.git\\s+GIT_TAG\\s+(?<currentValue>\\S*\\.\\S+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "CPM dependencies (non-GitHub) in CMakeLists.txt",
      "managerFilePatterns": [
        "/^CMakeLists\\.txt$/"
      ],
      "matchStrings": [
        "GIT_REPOSITORY\\s+(?<packageName>https://nheko\\.im/\\S+\\.git)\\s+GIT_TAG\\s+(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "git-tags"
    },
    {
      "customType": "regex",
      "description": "Flatpak GitHub git sources (tag before url)",
      "managerFilePatterns": [
        "/^etc/packaging/flatpak/cc\\.etke\\.komai\\.yaml$/"
      ],
      "matchStrings": [
        "tag:\\s+(?<currentValue>\\S+)\\n(?:\\s+[\\w-]+:[^\\n]*\\n)*?\\s+url:\\s+https://github\\.com/(?<depName>[^/]+/[^/]+)\\.git"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Flatpak GitHub git sources (url before tag)",
      "managerFilePatterns": [
        "/^etc/packaging/flatpak/cc\\.etke\\.komai\\.yaml$/"
      ],
      "matchStrings": [
        "url:\\s+https://github\\.com/(?<depName>[^/]+/[^/]+)\\.git\\n\\s+tag:\\s+(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Flatpak non-GitHub git sources (tag before url)",
      "managerFilePatterns": [
        "/^etc/packaging/flatpak/cc\\.etke\\.komai\\.yaml$/"
      ],
      "matchStrings": [
        "tag:\\s+(?<currentValue>\\S+)\\n(?:\\s+[\\w-]+:[^\\n]*\\n)*?\\s+url:\\s+(?<packageName>https://(?:nheko\\.im|gitlab\\.matrix\\.org|gitlab\\.freedesktop\\.org|git\\.openldap\\.org)/\\S+\\.git)"
      ],
      "datasourceTemplate": "git-tags"
    },
    {
      "customType": "regex",
      "description": "Fluent UI System Icons version pin",
      "managerFilePatterns": [
        "/^bin/icons/fluent/VERSION_REF$/"
      ],
      "matchStrings": ["(?m)^(?<currentValue>\\d+\\.\\d+\\.\\d+)$"],
      "depNameTemplate": "microsoft/fluentui-system-icons",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Font Awesome version pin",
      "managerFilePatterns": [
        "/^bin/icons/fontawesome/VERSION_REF$/"
      ],
      "matchStrings": ["(?m)^(?<currentValue>\\d+\\.\\d+\\.\\d+)$"],
      "depNameTemplate": "FortAwesome/Font-Awesome",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "CLDR annotations npm tarball version pin for emoji pipeline (sha256 pins in the lock must be updated on bump; `just emoji-update-lock` re-pins them)",
      "managerFilePatterns": [
        "/^bin/emoji/sources\\.lock\\.yml$/"
      ],
      "matchStrings": ["version:\\s+\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "cldr-annotations-full",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Element Call embedded bundle version pin (sha256 in the lock must be updated by hand on bump; fetch.py prints the right hash)",
      "managerFilePatterns": [
        "/^bin/element-call/sources\\.lock\\.yml$/"
      ],
      "matchStrings": ["version:\\s+\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "@element-hq/element-call-embedded",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "AppImage Docker base image",
      "managerFilePatterns": [
        "/^etc/packaging/appimage/builder-image$/"
      ],
      "matchStrings": ["(?:docker\\.io/)?(?<depName>[^:\\s]+):(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Ubuntu Docker image — managed manually, not by Renovate",
      "matchPackageNames": ["ubuntu"],
      "enabled": false
    },
    {
      "description": "Group all Rust crate updates",
      "matchManagers": ["cargo"],
      "groupName": "rust dependencies"
    },
    {
      "description": "GStreamer — stable (even-minor) series only; odd-minor development snapshots can fail to build and get no bug-fix releases",
      "matchPackageNames": ["https://gitlab.freedesktop.org/gstreamer/gstreamer.git"],
      "allowedVersions": "/^1\\.\\d*[02468]\\.\\d+$/"
    },
    {
      "description": "Development tooling and CI: automerge on a branch (no pull request, no email) once CI is green. A bad bump here surfaces as a red build, not as damage to anything.",
      "matchManagers": ["github-actions", "mise", "pre-commit"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Rust toolchain and crates: automerge on a branch. ci.yml compiles the project, so a crate that does not build cannot merge.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Icon asset pins: automerge on a branch. These are build-time asset bundles rather than libraries, they move almost daily, and the build consumes them - so a broken bump fails CI. Matched by name because they share the custom.regex manager with the CPM library pins, which must stay reviewed.",
      "matchDepNames": ["microsoft/fluentui-system-icons", "FortAwesome/Font-Awesome"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Majors always get a pull request. Listed last, so it overrides every automerge rule above.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
