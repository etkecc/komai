#!/usr/bin/env bash
#
# Build Komai and produce a snap package.
# Requires snapcraft installed on the host (or runs inside the Docker build).
#
# Usage:
#   etc/packaging/snap/bin/build-native <source_dir> <output_dir>
#
# The output .snap will be written to <output_dir>/komai_<version>_amd64.snap

set -euo pipefail

src_dir="${1:?Usage: build-native <source_dir> <output_dir>}"
out_dir="${2:?Usage: build-native <source_dir> <output_dir>}"

snap_dir="$src_dir/etc/packaging/snap"
build_dir="${SNAP_BUILD_DIR:-/tmp/komai-snap-build}"
komai_version="$(tr -d '[:space:]' < "$src_dir/VERSION")"
host_arch="$(dpkg --print-architecture 2>/dev/null || echo amd64)"

echo "=== Preparing snap build tree ==="
# snapcraft expects snap/snapcraft.yaml relative to the project root.
# Copy source tree to a temporary location and place snapcraft.yaml.
rm -rf "$build_dir"
mkdir -p "$build_dir"
tar -cf - -C "$src_dir" \
    --exclude=var \
    --exclude=.git \
    --exclude=src/rust/target \
    . | tar -xf - -C "$build_dir"
mkdir -p "$build_dir/snap"
cp "$snap_dir/snap/snapcraft.yaml" "$build_dir/snap/snapcraft.yaml"

echo "=== Building snap ==="
cd "$build_dir"

# In Docker containers, snapcraft cannot use its usual LXD/Multipass isolation,
# so --destructive-mode is required.  The Docker build script sets this variable.
if [[ "${SNAP_DESTRUCTIVE_MODE:-}" == "1" ]]; then
    snapcraft pack --destructive-mode
else
    snapcraft pack
fi

echo "=== Copying result ==="
mkdir -p "$out_dir"
# Remove old snap files so version bumps don't accumulate cruft.
rm -f "$out_dir"/komai_*.snap
cp "$build_dir"/komai_*.snap "$out_dir/"
echo "Snap: $out_dir/komai_${komai_version}_${host_arch}.snap"
