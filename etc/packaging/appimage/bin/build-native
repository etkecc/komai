#!/usr/bin/env bash
#
# Build Komai and produce an AppImage bundle.
# Runs directly on the host -- requires Ubuntu 26.04+ with build deps installed.
#
# Usage:
#   etc/packaging/appimage/bin/build-native <source_dir> <output_dir>
#
# The output .AppImage will be written to <output_dir>/komai-<version>-<arch>.AppImage

set -euo pipefail

# appimage-builder checks for apt-key on $PATH but never actually calls it
# (keys are handled via trusted.gpg.d).  Ubuntu 25.04 removed apt-key, so
# a no-op stub is needed.  The Docker recipe handles this automatically;
# for native builds, the user must create the stub themselves.
# See https://github.com/AppImageCrafters/appimage-builder/issues/372
if ! command -v apt-key &>/dev/null; then
    echo "ERROR: appimage-builder requires 'apt-key' on \$PATH, but it is not installed."
    echo ""
    echo "  Ubuntu 25.04+ removed apt-key, but appimage-builder still checks for it"
    echo "  (even though it never actually calls it).  Create a no-op stub:"
    echo ""
    echo "    printf '#!/bin/sh\\\nexit 0' | sudo tee /usr/bin/apt-key && sudo chmod +x /usr/bin/apt-key"
    echo ""
    echo "  Or use the Docker-based build instead:  just appimage-build-docker"
    echo ""
    echo "  Upstream issue: https://github.com/AppImageCrafters/appimage-builder/issues/372"
    exit 1
fi

# appimage-builder 1.1.0 uses packaging.version.parse() which rejects Debian
# version strings (e.g. "1.22.18ubuntu2") on packaging>=22.  Upstream fixed
# this on main (commit 728998d) but never released it.  The fix replaces the
# import and comparison with pydpkg.  The Docker recipe patches this
# automatically; for native builds the user must apply it themselves.
# See https://github.com/AppImageCrafters/appimage-builder/issues/311
#
# We probe whichever Python interpreter actually runs appimage-builder
# (read from its shebang), so the check works for both system pip
# installs and pipx-managed venvs.
ab_py="$(head -1 "$(command -v appimage-builder)" | sed -E 's|^#! *||')"
if "$ab_py" -c "from packaging import version; version.parse('1.0ubuntu1')" 2>/dev/null; then
    : # packaging is old enough to handle Debian versions (or patched)
elif ! "$ab_py" -c "from pydpkg import Dpkg" 2>/dev/null; then
    echo "WARNING: appimage-builder will likely crash on Debian version strings."
    echo ""
    echo "  The bundled appimage-builder 1.1.0 uses packaging.version.parse(),"
    echo "  which rejects versions like '1.22.18ubuntu2' on packaging>=22."
    echo "  Upstream fixed this (commit 728998d) but never released it."
    echo ""
    echo "  To fix, install pydpkg into the same venv and patch package.py:"
    echo ""
    echo "    pipx inject appimage-builder pydpkg"
    echo "    pkg_py=\$(\"$ab_py\" -c \"import appimagebuilder.modules.deploy.apt.package as m; print(m.__file__)\")"
    echo "    sed -i 's/from packaging import version/from pydpkg import Dpkg/' \"\$pkg_py\""
    echo "    sed -i 's/return version.parse(self.version) > version.parse(other.version)/return Dpkg.compare_versions(self.version, other.version) > 0/' \"\$pkg_py\""
    echo ""
    echo "  Or use the Docker-based build instead:  just appimage-build-docker"
    echo ""
    echo "  Upstream issue: https://github.com/AppImageCrafters/appimage-builder/issues/311"
    exit 1
fi

src_dir="${1:?Usage: build-native <source_dir> <output_dir>}"
out_dir="${2:?Usage: build-native <source_dir> <output_dir>}"
build_dir="${APPIMAGE_BUILD_DIR:-/tmp/komai-appimage-build}"
appimage_dir="${APPIMAGE_WORK_DIR:-/tmp/komai-appimage}"
komai_version="$(cat "$src_dir/VERSION.txt" | tr -d '[:space:]')"
host_arch="$(uname -m)"

# Map the host architecture to the arch-specific values the AppImageBuilder
# recipe needs: the apt arch, the apt mirror (amd64/i386 live on
# archive.ubuntu.com, every other port lives on ports.ubuntu.com), the
# multiarch library tuple, and the appimagetool runtime arch.
case "$host_arch" in
    x86_64)
        apt_arch="amd64"
        apt_mirror="http://archive.ubuntu.com/ubuntu/"
        lib_tuple="x86_64-linux-gnu"
        appimage_arch="x86_64"
        ;;
    aarch64)
        apt_arch="arm64"
        apt_mirror="http://ports.ubuntu.com/ubuntu-ports/"
        lib_tuple="aarch64-linux-gnu"
        appimage_arch="aarch64"
        ;;
    *)
        echo "ERROR: unsupported architecture '$host_arch' (expected x86_64 or aarch64)." >&2
        exit 1
        ;;
esac

echo "=== Configuring build ==="
cmake -GNinja -H"$src_dir" -B"$build_dir" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=OFF \
    -DMAN=OFF \
    -DFETCHCONTENT_QUIET=OFF
# MAN=OFF: AppImageBuilder.yml already excludes usr/share/man from the
# bundled AppDir, so rendering the man page would just be wasted work.

echo "=== Compiling ($(nproc) jobs) ==="
cmake --build "$build_dir" --parallel "$(nproc)"

echo "=== Installing to AppDir ==="
mkdir -p "$appimage_dir"
DESTDIR="$appimage_dir/AppDir" cmake --install "$build_dir"

echo "=== Packaging AppImage ($host_arch) ==="
# Inject the version from VERSION.txt and the arch-specific values derived
# above into the AppImageBuilder recipe template. The mirror substitution
# uses a `|` delimiter because the URL contains slashes.
sed -e "s/version: latest/version: $komai_version/" \
    -e "s|@APT_MIRROR@|$apt_mirror|g" \
    -e "s/@APT_ARCH@/$apt_arch/g" \
    -e "s/@LIB_TUPLE@/$lib_tuple/g" \
    -e "s/@APPIMAGE_ARCH@/$appimage_arch/g" \
    "$src_dir/etc/packaging/appimage/AppImageBuilder.yml" > "$appimage_dir/AppImageBuilder.yml"
cd "$appimage_dir"
appimage-builder --skip-test --recipe AppImageBuilder.yml

echo "=== Copying result ==="
mkdir -p "$out_dir"
# Remove old AppImage files so version bumps don't accumulate cruft.
rm -f "$out_dir"/komai-*.AppImage
cp "$appimage_dir/komai-$komai_version-$host_arch.AppImage" "$out_dir/"
echo "AppImage: $out_dir/komai-$komai_version-$host_arch.AppImage"
