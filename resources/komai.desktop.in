[Desktop Entry]
Name=Komai
Version=1.0
Comment=Desktop client for Matrix
Exec=@KOMAI_EXECUTABLE_NAME@ %u
Icon=@KOMAI_DESKTOP_ICON_NAME@
Type=Application
Categories=Network;InstantMessaging;Qt;
StartupWMClass=@KOMAI_STARTUP_WM_CLASS@
Terminal=false
MimeType=x-scheme-handler/matrix;
X-GNOME-UsesNotifications=true
# Allows finding Komai using application launchers and software shops more easily
Keywords=Matrix;matrix.org;chat;irc;communications;talk;riot;element;fractal;voip;
X-KDE-Keywords=Matrix,matrix.org,chat,irc,communications,talk,riot,element,fractal,voip,
# to be listed properly in some stores
X-Purism-FormFactor=Workstation;Mobile;
